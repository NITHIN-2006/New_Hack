PORT=5000
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/aido
JWT_SECRET=replace-with-a-long-random-secret

# These are used to create/update the server-authenticated admin account.
ADMIN_EMAIL=admin@aido.in
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Google Gemini (keep this key only in the server environment)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated browser origins allowed to call the API.
WEB_ORIGINS=http://localhost:3000,http://localhost:9000
