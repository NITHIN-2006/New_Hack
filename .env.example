# AIDO Platform - 100% Free & Open-Source
# No API keys required. Maps are powered entirely by Leaflet and OpenStreetMap.

# Standalone AIDO admin panel URL (aido-admin-panel Vite dev server uses port 9000)
VITE_ADMIN_PANEL_URL=http://localhost:9000

# AIDO API (PostgreSQL-backed authentication and feedback)
VITE_API_BASE_URL=http://localhost:5000/api/v1
